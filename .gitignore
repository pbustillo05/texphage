# =============================================================================
# texphage — .gitignore
# =============================================================================

# =============================================================================
# PROJECT-SPECIFIC
# =============================================================================

# Package cache (JSON + lock files generated by find_packages.py)
cache/

# Agent test runs (PDFs, tarballs, logs — can be huge)
tests/runs/
# Except the committed testing history log
!tests/runs/HISTORY.md

# Regex test suite: only .tex and manifest.json are committed.
# LaTeX build artifacts from Gemini's compilation verification are excluded
# by the global *.aux / *.log / *.pdf / etc. rules below.

# Unfolded tex files saved by extractor.py
cache/unfolded_tex/

# =============================================================================
# PYTHON
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
wheels/
sdist/
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.pytest_cache/
.tox/
.nox/
# pytest tmp_path directories created in project root when rootdir == project
pytest-of-*/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# =============================================================================
# LATEX AUXILIARY FILES
# =============================================================================

# Core auxiliary outputs (generated on every compile)
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2

# Bibliography
*.bbl
*.bcf
*.blg
*-blx.aux
*-blx.bib
*.run.xml

# Indices
*.idx
*.ilg
*.ind
*.ist

# Glossaries
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs
*.lzo
*.lzs
*.slg
*.slo
*.sls

# Figures generated from source
*.pdf_tex
*-converted-to.*

# latexmk
*.fdb_latexmk
*.synctex
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync

# hyperref
*.nlo

# Beamer
*.nav
*.pre
*.snm
*.vrb

# Minted (code highlighting cache)
_minted*/
*.pyg

# Listings
*.lol

# TikZ externalization
*.dpth
*.md5
*.auxlock

# Nomenclature
*.nlg
*.nls

# =============================================================================
# COMPILED OUTPUT (not source)
# =============================================================================

# PDFs are compiled outputs; not committed unless they are source figures.
# To commit a specific figure PDF, add an exception below, e.g.:
#   !figures/my_diagram.pdf
*.pdf

# Other compiled formats
*.dvi
*.xdv
*.ps

# =============================================================================
# macOS
# =============================================================================

.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Spotlight / Time Machine
.Spotlight-V100
.VolumeIcon.icns
.TemporaryItems
.Trashes
.fseventsd
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# =============================================================================
# VS CODE
# =============================================================================

.vscode/
*.code-workspace

# Local history extension
.history/

# =============================================================================
# CLAUDE / ANTHROPIC
# =============================================================================

# Track .claude/ (agents, skills, settings.json) but not machine-local overrides.
.claude/settings.local.json

# NOTE: CLAUDE.md, AGENTS.md, .claude/agents/, and .claude/skills/ are committed.

# Worktrees created by coding-agent / arxiv-fidelity (machine-local)
.claude/worktrees/

# =============================================================================
# JETBRAINS (PyCharm, etc.)
# =============================================================================

.idea/
*.iws
*.iml
*.ipr
out/

# =============================================================================
# GENERAL
# =============================================================================

# Editor swap files
*.swp
*.swo
*~

# Downloaded archives (arXiv tarballs, etc.)
*.tar
*.tar.gz
*.tar.bz2
*.zip
*.gz
*.tgz

# Secrets
.env
.env.*
*.pem
*.key

# Windows

Thumbs.db

ehthumbs.db

Desktop.ini



# =============================================================================
# GEMINI / GOOGLE
# =============================================================================

# Gemini has been retired. Keep settings.local.json gitignored in case it exists.
.gemini/settings.local.json
